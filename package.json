    "postbuild": "node scripts/copy-404.js",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
