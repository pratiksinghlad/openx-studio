{
  "name": "openx-studio",
  "version": "1.0.0",
  "description": "OpenX Studio — In-Browser Scenario Player, Editor, and Simulator for ASAM OpenSCENARIO and OpenDRIVE",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
